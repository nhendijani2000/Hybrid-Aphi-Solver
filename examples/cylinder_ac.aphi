# ---------------------------------------------------------------------------
# The cylinder of cylinder_box.aphi, at a single AC frequency.
#
# This file exists because the DC milestone cannot be RUN yet.
# cylinder_box.aphi is a DC case, DC forces `conditioning = natural`, and the
# unsymmetric LU that needs is step 8 of docs/SOLVER_PLAN.md. So this is the
# cylinder in the form the solver can currently solve end to end, and it is what
# produces a `potential.out` to look at:
#
#     solve_mesh examples/cylinder_ac.aphi
#
# It is NOT the validation case. R = 0.1388 mOhm and L = 0.3870 nH belong to the
# DC run; nothing here has been checked against a physical expectation, and the
# extraction that would do so does not exist yet either.
#
# One difference from cylinder_box.aphi worth noticing: the voltage port is held
# at 1 V rather than 0 V, so the potential has a non-trivial real part to look at
# in the output. At 0 V the interesting variation is entirely imaginary.
# ---------------------------------------------------------------------------

[mesh]
file        = ../meshes/cylinder_box.msh
length_unit = mm

[analysis]
type        = frequency
frequencies = 1e8                          # 100 MHz
formulation = full_wave                    # Phi on the whole domain, not just the wire

[boundary]
outer       = flux_tangential

[Body B1]
volume      = wire
sigma       = 5.8e7
eps_r       = 1
mu_r        = 1

[Body B2]
volume      = air
sigma       = 0

[port P1]
type        = boundary_current
surface     = wire_bottom
current     = 1.0                          # A, peak

[port P2]
type        = boundary_voltage
surface     = wire_top
voltage     = 1.0                          # V -- see the note above

[solver]
# natural would be unsymmetric, and its LU is step 8. Both symmetric forms work.
conditioning = row_scaled
