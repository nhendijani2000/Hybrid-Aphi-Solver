# ---------------------------------------------------------------------------
# A conducting ring driven through an internal cut -- the second test case.
#
# A loop has no boundary face to attach an electrode to, so it can only be
# driven by cutting it: `loop_cut` is a complete cross-section of the ring,
# tagged as a Physical Surface, with a tet on each side.
#
# current_direction is a HINT, not a normal. The cut's normal comes from its
# own faces; the hint only resolves the remaining +/- sign, so anything
# within 90 degrees of what you mean gives the same answer -- `+y`, `0 1 0`
# and `0.1 0.9 -0.2` are identical input. For a ring in the x-y plane cut at
# the half-plane y = 0, x > 0, the cut's normal is +/-y, so `+y` reads as
# "counterclockwise seen from +z".
#
# The side the hint points AWAY from is held at 0 V, which is what makes this
# port its own potential reference -- a floating loop needs no other.
#
# Omitting current_direction is legal here (one internal port): the direction
# is then derived from the mesh and the reported signs of I and V become
# arbitrary, which the driver warns about. Try deleting the line to see it.
# Z, R, L and P are unaffected either way.
#
# NOTE: meshes/loop_cut.msh DOES NOT EXIST YET, so running this file stops
# with "mesh: could not open file". That is correct behaviour -- the solver
# now opens the mesh -- but it means this example is not runnable until the
# loop geometry is built. cylinder_box.aphi is the one to run today.
# ---------------------------------------------------------------------------

[mesh]
file        = ../meshes/loop_cut.msh
length_unit = mm

[analysis]
type        = dc

[boundary]
outer       = flux_tangential

[Body B1]
volume      = ring
sigma       = 5.8e7
eps_r       = 1
mu_r        = 1

[Body B2]
volume      = air
sigma       = 0

[port P1]
type              = internal_current
surface           = loop_cut
current_direction = +y                     # or: 0 1 0, or -y to reverse
current           = 1.0
