# ---------------------------------------------------------------------------
# The cylinder at 50 Hz, driven by a POTENTIAL DIFFERENCE: 1 V on the top cap,
# 0 V on the bottom. For looking at how Phi varies through the wire and the box.
#
#     solve_mesh examples/cylinder_50hz.aphi
#
# writes potential.out and potential.vtk; open the second in ParaView.
#
# WHAT TO EXPECT, and it is worth knowing before looking at the picture.
#
# Skin depth in copper at 50 Hz is 9.35 mm against a wire radius of 0.2 mm, so
# there is no skin effect at all: the current is uniform and the exact potential
# in the WIRE is Phi = z / l, a straight line from 0 V to 1 V. That is a linear
# function, so it lies in the P2 space exactly -- the discrete solution should
# reproduce it to round-off, not approximately. It is the sharpest check
# available without any field extraction.
#
# `formulation = full_wave` keeps Phi in the AIR as well. That is deliberate but
# it is not the physically natural choice here: at 50 Hz the air's coefficient is
# beta = j*omega*eps0 = 2.8e-9 against the copper's sigma = 5.8e7, a contrast of
# 2e16 in the Phi block. `formulation = reduced` would drop the air's Phi
# entirely and is the standard eddy-current model for this regime. Expect the air
# potential to be numerically delicate, and treat the wire's as the meaningful
# part.
# MEASURED: worst |Re(Phi) - z/l| = 4.02e-07 over 12038 wire nodes. But do NOT
# read anything into phi_imag: Phi is fixed only up to a P1 gauge function that
# the spanning tree picks arbitrarily, and the shift is -j*omega*psi, i.e. almost
# purely imaginary. See docs/POSTPROCESSING_PLAN.md section 9.
#
# ---------------------------------------------------------------------------

[mesh]
file        = ../meshes/cylinder_box.msh
length_unit = mm

[analysis]
type        = frequency
frequencies = 50                           # Hz
formulation = full_wave

[boundary]
outer       = flux_tangential

[Body B1]
volume      = wire
sigma       = 5.8e7
eps_r       = 1
mu_r        = 1

[Body B2]
volume      = air
sigma       = 0

[port P1]
type        = boundary_voltage
surface     = wire_top
voltage     = 1.0                          # V

[port P2]
type        = boundary_voltage
surface     = wire_bottom
voltage     = 0.0                          # V, the reference

[solver]
conditioning = row_scaled
