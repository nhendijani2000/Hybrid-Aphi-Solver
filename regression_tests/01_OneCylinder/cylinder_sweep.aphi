# ---------------------------------------------------------------------------
# 01_OneCylinder -- the same cylinder swept in frequency, 50 Hz to 500 Hz.
#
#     ../run_case.bat cylinder_sweep.aphi            (from this folder)
#
# Everything it writes lands in ./output/, one potential_N.out and
# potential_N.vtk per frequency, numbered in the order listed below.
#
# This takes about 10 minutes: the symbolic analysis is done once, but each
# frequency needs its own numeric factorization (~93 s on 49276 unknowns).
#
# ---------------------------------------------------------------------------
# WHAT THE SWEEP IS FOR, AND WHERE IT STOPS BEING TRUSTWORTHY
#
# The exact profile in a round wire is J(r)/J(a) = J0(kr)/J0(ka) with
# k = (1-j)/delta. Computed, not estimated:
#
#   f        delta      a/delta   elem per delta   |J(0)/J(a)| exact
#   50 Hz    9.3459 mm    1.07         4.67            0.9265
#   100 Hz   6.6086 mm    1.51         3.30            0.7750
#   200 Hz   4.6730 mm    2.14         2.34            0.5055
#   500 Hz   2.9554 mm    3.38         1.48            0.1826
#
# The mesh has lc_skin = 2.0 mm at the conductor surface, so:
#
#   50 Hz    well resolved   -- measured 0.948 against 0.9414 exact for the
#                              same bin centres, 0.7 %
#   100 Hz   good
#   200 Hz   marginal        -- 2.3 elements per skin depth
#   500 Hz   NOT resolved    -- 1.5 elements per skin depth; expect too much
#                              current left in the core
#
# The 500 Hz point is kept deliberately. A regression suite is more useful
# with one case whose answer is known to be wrong by a known amount, because
# that is what distinguishes "the code changed" from "the code got worse".
# ---------------------------------------------------------------------------

[mesh]
file        = cylinder.msh
length_unit = mm

[output]
directory   = output

[analysis]
type        = frequency
frequencies = 50, 100, 200, 500           # Hz
formulation = full_wave

[boundary]
outer       = flux_tangential

[Body B1]
volume      = wire
sigma       = 5.8e7                        # copper
eps_r       = 1
mu_r        = 1

[Body B2]
volume      = air
sigma       = 0

[port P1]
type        = boundary_voltage
surface     = wire_top
voltage     = 1.0                          # V

[port P2]
type        = boundary_voltage
surface     = wire_bottom
voltage     = 0.0                          # V, the reference

[solver]
conditioning = row_scaled
