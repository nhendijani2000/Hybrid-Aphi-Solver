# The repo's root .gitignore covers regression_tests/*/output/* but not the
# per-permutation output directories this case adds, and it force-includes
# *.msh, which would commit the permuted meshes too. Both are derived.

# ~307 MB each.
output_perm*/

# Regenerate with the seeds recorded in measure_gauge.py's header and
# ../07_GaugeInvariance/permute_nodes.py:
#     permute('stub_rod.msh', 'stub_rod_permA.msh', 12345)
#     permute('stub_rod.msh', 'stub_rod_permB.msh', 777)
stub_rod_perm*.msh

# The case 03 control: three more solves, ~307 MB of output each, and two more
# permuted copies of case 02's mesh. All derived -- see README.md "The control".
output_control03_*/
control03_perm*.msh

# Per-run solver logs from the gauge-free potential runs; the numbers that
# matter are in README.md and GAUGE_CHOICE.md 15.10.
gf_*.log
